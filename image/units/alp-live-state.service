[Unit]
Description=ALP-OS Live: mount Live's own state from the stick
DefaultDependencies=no
# The installed system has no alp-live-protect (which settles udev on
# Live), so wait for udev here too: the partition labels come from it.
After=alp-live-protect.service systemd-udev-trigger.service local-fs.target
Before=alp-live-archive.service alp-live-report.service sysinit.target
ConditionPathIsMountPoint=!/var/lib/alp

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/bin/udevadm settle --timeout=30
ExecStart=/usr/bin/alpctl live archive state-mount
# T44: a start never waits forever (udev settle 30 s + the mount).
TimeoutStartSec=90s

[Install]
WantedBy=sysinit.target
