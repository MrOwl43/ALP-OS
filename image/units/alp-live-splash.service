[Unit]
Description=ALP-OS Live: "ALPArchive is starting" on the screen
DefaultDependencies=no
After=systemd-vconsole-setup.service
Before=sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/bin/alpctl live splash
TimeoutStartSec=10s
StandardOutput=tty
TTYPath=/dev/tty1

[Install]
WantedBy=sysinit.target
