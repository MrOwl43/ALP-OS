# Updates in place (ADR 0026): after an update the new version starts with a
# boot counter (three tries). Once this start is healthy
# (boot-complete.target, which requires alp-healthy.target), the counter is
# removed, so systemd-boot keeps starting this version. Stands in for
# systemd-bless-boot.service (masked): the start files are on the alp-boot
# partition, which is mounted only for this moment.
[Unit]
Description=ALP-OS Live: mark this start of a new version as good
DefaultDependencies=no
# Set by systemd-boot only when the started entry has a boot counter.
ConditionPathExists=/sys/firmware/efi/efivars/LoaderBootCountPath-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
Requires=boot-complete.target
After=local-fs.target boot-complete.target alp-live-state.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/alpctl live update bless
TimeoutStartSec=120s
