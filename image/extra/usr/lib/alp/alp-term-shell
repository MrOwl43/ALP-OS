#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# The Terminal's shell (docs/plans/live-terminal.md), started by ttyd as
# alp-term. A clean environment: nothing of ttyd's (the session's path is
# in it) is passed on. bash reads only ALPArchive's fixed settings
# (alp-term.bashrc, on the read-only system), never a user's profile.
exec /usr/bin/env -i HOME=/tmp TERM="${TERM:-xterm-256color}" LANG=C.UTF-8 \
    PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin \
    /bin/bash --noprofile --rcfile /usr/lib/alp/alp-term.bashrc -i
