{
  "backup": {
    "database": {
      "enabled": true,
      "cronExpression": "0 02 * * *",
      "keepLastAmount": 14
    }
  },
  "job": {
    "backgroundTask": {
      "concurrency": 1
    },
    "library": {
      "concurrency": 1
    },
    "metadataExtraction": {
      "concurrency": 1
    },
    "migration": {
      "concurrency": 1
    },
    "notifications": {
      "concurrency": 1
    },
    "search": {
      "concurrency": 1
    },
    "sidecar": {
      "concurrency": 1
    },
    "thumbnailGeneration": {
      "concurrency": 1
    },
    "videoConversion": {
      "concurrency": 1
    },
    "faceDetection": {
      "concurrency": 1
    },
    "smartSearch": {
      "concurrency": 1
    },
    "ocr": {
      "concurrency": 1
    }
  },
  "library": {
    "scan": {
      "enabled": false,
      "cronExpression": "0 0 * * *"
    },
    "watch": {
      "enabled": false
    }
  },
  "machineLearning": {
    "enabled": false,
    "availabilityChecks": {
      "enabled": false,
      "interval": 30000,
      "timeout": 2000
    },
    "clip": {
      "enabled": false,
      "modelName": "ViT-B-32__openai"
    },
    "duplicateDetection": {
      "enabled": false,
      "maxDistance": 0.01
    },
    "facialRecognition": {
      "enabled": false,
      "maxDistance": 0.5,
      "minFaces": 3,
      "minScore": 0.7,
      "modelName": "buffalo_l"
    },
    "ocr": {
      "enabled": false,
      "maxResolution": 736,
      "minDetectionScore": 0.5,
      "minRecognitionScore": 0.8,
      "modelName": "PP-OCRv5_mobile"
    }
  },
  "map": {
    "enabled": false
  },
  "newVersionCheck": {
    "enabled": false
  },
  "nightlyTasks": {
    "clusterNewFaces": false,
    "databaseCleanup": true,
    "generateMemories": true,
    "missingThumbnails": true,
    "startTime": "03:00",
    "syncQuotaUsage": true
  },
  "oauth": {
    "enabled": false
  },
  "passwordLogin": {
    "enabled": true
  },
  "reverseGeocoding": {
    "enabled": true
  },
  "server": {
    "externalDomain": "",
    "loginPageMessage": "",
    "publicUsers": false
  },
  "storageTemplate": {
    "enabled": false
  },
  "trash": {
    "enabled": true,
    "days": 30
  },
  "user": {
    "deleteDelay": 7
  }
}
